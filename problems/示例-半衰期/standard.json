{
  "spec": "v1",
  "title": "半衰期：氡 222 的衰变",
  "stem": "氡 222 经 α 衰变变成钋 218，半衰期为 3.8 天。现有 16 g 氡，求：(1) 写出衰变方程并判断质量数、电荷数是否守恒；(2) 经过 7.6 天还剩多少克氡；(3) 经过多少天剩下的氡只有原来的 1/8。",
  "params": { "m0": [16, "g", "氡的初始质量"], "T": [3.8, "天", "半衰期"] },
  "scene": {
    "surfaces": [], "bodies": [],
    "nuclear": {
      "duration": 15.2,
      "species": [{ "id": "Rn", "N0": 1000, "m0": "m0", "half": "T" }],
      "reaction": { "left": [["Rn", 222, 86]], "right": [["Po", 218, 84], ["He", 4, 2]] }
    }
  },
  "asks": [
    { "id": "1", "text": "衰变方程守恒", "option": { "label": "1", "text": "这个衰变方程质量数和电荷数都守恒", "correct": true, "claim": "val(A_in)==val(A_out) && val(Z_in)==val(Z_out)" } },
    { "id": "2", "text": "7.6 天后剩余的氡", "at": { "event": "time", "t": 7.6 }, "expr": "val(m_Rn)", "answer": 4, "unit": "g" },
    { "id": "3", "text": "剩 1/8 所需时间", "at": { "event": "when", "expr": "val(frac_Rn)-1/8", "dir": -1 }, "expr": "t", "answer": 11.4, "unit": "天" }
  ],
  "idea": "放射性衰变是大量原子核的统计规律：每过一个半衰期，还没衰变的核剩下一半，和外界条件无关。",
  "solution": {
    "1": [{ "say": "α 衰变放出氦核，左右两边质量数 222 = 218 + 4，电荷数 86 = 84 + 2，都守恒。", "tex": "{}^{222}_{86}\\mathrm{Rn}\\to{}^{218}_{84}\\mathrm{Po}+{}^{4}_{2}\\mathrm{He}" }],
    "2": [{ "say": "7.6 天是 2 个半衰期，剩下 $(1/2)^2$。", "tex": "m=m_0\\left(\\tfrac12\\right)^{t/T}=16\\times\\tfrac14=4\\ \\mathrm{g}" }],
    "3": [{ "say": "$1/8=(1/2)^3$，要经过 3 个半衰期。", "tex": "t=3T=11.4\\ \\text{天}" }]
  }
